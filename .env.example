# map-service-admin 환경변수 예시 (cut 2 — 운영 콘솔 JSON API)
#
# 실제 실행 시 admin 컨테이너는 map-service-infra 의 공유 ./.env 를 읽는다
# (docker-compose x-app-env). 아래 키를 그 공유 .env 에 추가해야 한다.
# 공유 .env 의 무관한 키(POSTGRES_*, KMA_* 등)는 extra="ignore" 로 무시된다.

# [필수] map_admin DSN. hub_data SELECT + admin_data 소유 RW.
# 비밀번호는 infra .env 의 MAP_ADMIN_PASSWORD 와 일치해야 한다.
ADMIN_DATABASE_URL=postgresql+psycopg://map_admin:replace-with-map-admin-password@postgres:5432/map
DB_TIMEOUT_SEC=5.0

# [운영자 인증] admin_accounts(bcrypt) + 서버측 세션(HttpOnly 쿠키).
# 최초 계정: admin_accounts 가 비어 있을 때만 아래 자격으로 1회 시드한다.
ADMIN_BOOTSTRAP_USER=admin
ADMIN_BOOTSTRAP_PASSWORD=replace-with-strong-password
ADMIN_SESSION_TTL_MIN=720
# 터널(HTTPS) 배포 시 true. loopback dev 는 false.
ADMIN_SESSION_COOKIE_SECURE=false

# [CORS] dev SPA(Vite) 교차출처. 프로덕션은 nginx same-origin 이라 비워 둔다.
# 콤마 구분 또는 JSON 배열. 예: http://localhost:5173
# ADMIN_CORS_ORIGINS=["http://localhost:5173"]

# [헬스 롤업 대상] map-net 내부 컨테이너명+컨테이너포트
USER_BASE_URL=http://user:8080
AGENT_BASE_URL=http://agent:8000
HUB_BASE_URL=http://hub:8000

# [OSRM 프로브] hub 와 동일 키(공유 .env). 비면 프로브/헬스 skip.
OSRM_FOOT_BASE_URL=http://osrm-foot:5000
OSRM_BICYCLE_BASE_URL=http://osrm-bicycle:5000

# [Redis 진단 RO] 스트림(DB2)/Gemini 쿼터(DB3)/캐시(DB4) 조회.
ADMIN_REDIS_URL=redis://redis:6379

# [내부 위임] hub/BFF `/internal` 아웃바운드 토큰(공유 비밀 재사용).
INTERNAL_SERVICE_TOKEN=replace-with-shared-internal-token

# [외부 API 상태/프로브] hub 소유 키(공유 .env)를 상태표시·수동프로브에 사용.
# 값은 마스킹해서만 노출된다.
GEMINI_API_KEY=
KAKAO_REST_API_KEY=
KMA_SERVICE_KEY=
TOUR_API_SERVICE_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# [타임아웃(선택)]
HEALTH_TIMEOUT_SEC=3.0
GEMINI_TIMEOUT_SEC=5.0
REDIS_TIMEOUT_SEC=2.0
INTERNAL_TIMEOUT_SEC=5.0
EXTERNAL_PROBE_TIMEOUT_SEC=6.0

# [DB 뷰어(hub_data) 페이지네이션/내보내기]
DB_PAGE_SIZE_DEFAULT=50
DB_PAGE_SIZE_MAX=500
DB_EXPORT_MAX_ROWS=50000

# [외부 모니터링 연동 슬롯(선택)] 새 Grafana(compose monitoring 프로파일)를
# SPA 모니터링 화면에 iframe/링크로 연결한다. JSON 배열 1줄.
# MONITORING_PANELS=[{"title":"Grafana · MAP 개요","url":"http://127.0.0.1:3000/d/UID/map?kiosk&refresh=30s","embed":true,"height":460,"description":"서비스 지표 개요"},{"title":"Prometheus","url":"http://127.0.0.1:9090","embed":false,"description":"메트릭 쿼리 콘솔"}]

# Independent central admin: runtime and one-shot migration use separate credentials.
# When CONTROL is set, every target (including ADMIN_ENVIRONMENT) must be explicit
# in ADMIN_TARGETS. ADMIN_DATABASE_URL is an optional target read-only DSN there.
# ADMIN_CONTROL_DATABASE_URL=postgresql+psycopg://map_admin_runtime:...@control-db/admin
# Supply ADMIN_CONTROL_MIGRATION_DATABASE_URL only to the one-shot alembic job.
# ADMIN_RUN_MIGRATIONS=false
