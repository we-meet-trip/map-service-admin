# map-service-admin 환경변수 예시 (cut 1)
#
# 실제 실행 시 admin 컨테이너는 map-service-infra 의 공유 ./.env 를 읽는다
# (docker-compose x-app-env). 아래 키를 그 공유 .env 에 추가해야 한다.
# 공유 .env 의 무관한 키(POSTGRES_*, KMA_* 등)는 extra="ignore" 로 무시된다.

# [필수] map_admin(읽기전용) DSN. 비밀번호는 infra .env 의 MAP_ADMIN_PASSWORD 와 일치해야 한다.
ADMIN_DATABASE_URL=postgresql+psycopg://map_admin:replace-with-map-admin-password@postgres:5432/map

# [운영자 인증] 단일 공유 HTTP Basic (대시보드·/docs·API 공통)
ADMIN_BASIC_USER=admin
ADMIN_BASIC_PASSWORD=replace-with-strong-password

# [헬스 롤업 대상] map-net 내부 컨테이너명+컨테이너포트
USER_BASE_URL=http://user:8080
AGENT_BASE_URL=http://agent:8000
HUB_BASE_URL=http://hub:8000

# [Gemini 연결 점검] agent 와 동일한 공유 .env 의 GEMINI_API_KEY 를 읽는다.
# 미설정이면 대시보드에 "미설정" 으로 표시(연결 점검 생략).
GEMINI_API_KEY=

# [타임아웃(선택)]
HEALTH_TIMEOUT_SEC=3.0
DB_TIMEOUT_SEC=5.0
GEMINI_TIMEOUT_SEC=5.0

# [DB 뷰어(hub_data) 페이지네이션]
DB_PAGE_SIZE_DEFAULT=50
DB_PAGE_SIZE_MAX=500
